<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connexion — Dashboard des demandes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="min-height: 100vh;">
    <div class="card shadow-lg" style="width: 100%; max-width: 400px;">
        <div class="card-body p-4">
            <h1 class="h4 mb-3 text-center">🔐 Dashboard Admin</h1>
            <p class="text-muted text-center small mb-4">Gestion des types de demandes du bot Discord</p>

            <% if (erreur) { %>
                <div class="alert alert-danger" role="alert"><%= erreur %></div>
            <% } %>

            <form method="POST" action="/login">
                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe administrateur</label>
                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        required
                        autofocus
                    >
                </div>
                <button type="submit" class="btn btn-primary w-100">Se connecter</button>
            </form>
        </div>
    </div>
</body>
</html>
