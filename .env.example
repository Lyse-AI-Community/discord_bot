# === Configuration Discord ===
# Token secret de ton application Bot (portail développeur Discord > Bot > Reset Token)
DISCORD_TOKEN=ton_token_bot

# Client ID (Application ID) de ton application Discord
CLIENT_ID=ton_client_id

# (Optionnel) ID du serveur (guild) pour enregistrer les commandes slash en mode "guild"
# -> Recommandé en développement : les commandes sont disponibles instantanément.
# Si laissé vide, les commandes sont enregistrées en global (peut prendre jusqu'à 1h à apparaître).
GUILD_ID=

# === Configuration du serveur Web (Dashboard) ===
# Port d'écoute du serveur Express (Bot + Web tournent dans le même process)
PORT=3000

# Mot de passe d'accès au Dashboard d'administration
ADMIN_PASSWORD=un_mot_de_passe_securise

# (Optionnel) Clé secrète utilisée pour signer les cookies de session du Dashboard
# -> Change cette valeur en production.
SESSION_SECRET=change_moi_en_production
